{
  "name": "dsh-terminal",
  "version": "0.1.0",
  "description": "DSH bundle plugin: interactive terminal panels in the chat UI (node-pty + xterm.js). The agent sees terminal activity in real time via injected messages and read-only terminal_list/terminal_read tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node build-client.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@lydell/node-pty": "1.2.0-beta.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "esbuild": "^0.25.0",
    "xterm": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
